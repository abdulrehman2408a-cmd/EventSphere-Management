# ===================================================
# EventSphere Management — Backend Environment Config
# Copy this file to backend/.env and update credentials
# ===================================================

# Server Port & Mode
PORT=5000
NODE_ENV=development

# MongoDB Connection (Required — Persistent Storage)
# Option A: Local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/eventsphere
# Option B: MongoDB Atlas (Cloud)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/eventsphere?retryWrites=true&w=majority

# JWT Secret & Expiry (Required — Use a strong random secret in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=eventsphere_super_secure_jwt_secret_key_2026_xyz
JWT_EXPIRE=30d

# CORS Allowed Origin (Frontend URL)
CLIENT_URL=http://localhost:3000

# Initial Admin Setup Credentials (Used by: npm run admin:create)
# ADMIN_NAME=Administrator
# ADMIN_EMAIL=admin@eventsphere.com
# ADMIN_PASSWORD=YourSecurePassword123!

# Email / SMTP Configuration (Optional: Nodemailer)
# If left unconfigured, password reset emails are securely simulated and logged to console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EventSphere Team <support@eventsphere.pk>"
