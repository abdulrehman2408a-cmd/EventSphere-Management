# Dependencies
node_modules/
backend/node_modules/

# Build and Production Artifacts
dist/
build/
coverage/

# Environment Variables (NEVER commit secrets or production credentials)
backend/.env
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# User uploads (keep directory with .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep

# System & OS Files
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~

# IDE & Editor Config
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tmp
*.temp
.cache/
